{
  "name": "conduit-browser",
  "version": "3.1.0",
  "private": true,
  "description": "A linked multi-screen Electron browser with isolated sessions and per-screen routing.",
  "author": {
    "name": "Jujhar Aujla",
    "url": "https://github.com/jujharaujla"
  },
  "homepage": "https://github.com/jujharaujla/conduit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jujharaujla/conduit.git"
  },
  "bugs": {
    "url": "https://github.com/jujharaujla/conduit/issues"
  },
  "license": "MIT",
  "main": "src/main.js",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check src/main.js",
    "pack": "electron-builder --dir --config electron-builder.config.cjs",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "dist:mac": "electron-builder --mac dmg zip --config electron-builder.config.cjs",
    "dist:win": "electron-builder --win nsis portable --config electron-builder.config.cjs",
    "dist:linux": "electron-builder --linux AppImage --config electron-builder.config.cjs",
    "release:dry": "electron-builder --publish never --config electron-builder.config.cjs"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.1",
    "eslint-plugin-n": "18.2.2"
  },
  "keywords": [
    "electron",
    "browser",
    "multi-session",
    "browser-automation",
    "testing",
    "productivity"
  ]
}
